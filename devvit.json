{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "super-consolex",
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["generativelanguage.googleapis.com", "api.openai.com"]
    },
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "moderator"
    }
  },
  "blocks": {
    "entry": "src/main.tsx",
    "menu": {
      "enable": true
    },
    "settings": {
      "enable": true
    },
    "triggers": ["onPostSubmit", "onPostDelete", "onCommentDelete"]
  },
  "dev": {
    "subreddit": "super_consolex_dev"
  }
}
